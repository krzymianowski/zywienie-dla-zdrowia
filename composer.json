{
  "name": "zywienie-dla-zdrowia/zywienie-dla-zdrowia",
  "description": "Development tooling for the Żywienie dla Zdrowia WordPress plugin.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "squizlabs/php_codesniffer": "^3.13",
    "wp-coding-standards/wpcs": "^3.2"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "sort-packages": true
  },
  "scripts": {
    "lint": [
      "@lint:php",
      "@phpcs"
    ],
    "lint:php": "@php -l zywienie-dla-zdrowia.php",
    "phpcs": "phpcs"
  }
}
